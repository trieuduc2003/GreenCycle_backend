            "type": "integer",
            "format": "int32"
          },
          "actualWeights": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActualWeightDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
