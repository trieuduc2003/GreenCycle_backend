          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderDetailDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DepositRequest": {
        "type": "object",
        "properties": {
