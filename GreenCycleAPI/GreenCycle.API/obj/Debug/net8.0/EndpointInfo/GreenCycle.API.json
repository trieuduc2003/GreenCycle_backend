  "components": {
    "schemas": {
      "ActualWeightDto": {
        "type": "object",
        "properties": {
          "orderDetailId": {
            "type": "integer",
            "format": "int32"
          },
          "actualWeight": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "ConfirmTransactionRequestDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateOrderDetailDto": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "integer",
            "format": "int32"
          },
          "estimatedWeight": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateOrderRequestDto": {
        "type": "object",
        "properties": {
          "methodId": {
            "type": "integer",
            "format": "int32"
          },
          "yardId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pickupAddressId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderDetailDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InitiateTransactionRequestDto": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int32"
          },
          "actualWeights": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ActualWeightDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          },
          "roleId": {
            "type": "integer",
            "format": "int32"
          },
          "otpCode": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SendOtpRequestDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
