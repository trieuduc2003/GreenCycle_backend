        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "nullable": true
          },
          "roleId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "InitiateTransactionRequestDto": {
        "type": "object",
        "properties": {
